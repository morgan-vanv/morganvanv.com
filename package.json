{
  "name": "morganvanv.com",
  "version": "22.0.0",
  "scripts": {
    "ng": "ng",
    "content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-visitor-content.mjs",
    "prestart": "npm run content",
    "start": "ng serve",
    "prebuild": "node scripts/write-build-info.mjs && npm run content",
    "build": "ng build",
    "prewatch": "npm run content",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run content",
    "test": "ng test",
    "lint": "ng lint",
    "pretest:ci": "npm run content",
    "test:ci": "ng test --watch=false",
    "check": "npm run lint && npm run build -- --configuration=production && npm run test:ci",
    "layout": "node scripts/check-layout.mjs"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.4",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@google/model-viewer": "^4.3.1",
    "astronomy-engine": "^2.1.19",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "~5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.4.1",
    "happy-dom": "^21.0.4",
    "playwright-core": "~1.64.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "~5.0.5"
  },
  "overrides": {
    "@angular/build": {
      "vite": "8.3.5"
    }
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
