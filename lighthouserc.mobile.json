{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/browser",
      "url": [
        "http://localhost/",
        "http://localhost/home",
        "http://localhost/now",
        "http://localhost/background",
        "http://localhost/social",
        "http://localhost/interests",
        "http://localhost/projects",
        "http://localhost/blog"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
